	static {
		try {
			
		
		Class.forName(DBinfo.driver);
		con =DriverManager.getConnection(DBinfo.dburl,DBinfo.dbuname,DBinfo.dbpwd);
		System.out.println("Database Connected");
		} catch (Exception e) {
			// TODO: handle exception
		}
		}
	public static Connection getCon() {
